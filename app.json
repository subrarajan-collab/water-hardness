{
  "expo": {
    "name": "Water Hardness Tester",
    "slug": "water-hardness-tester",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1565C0"
      },
      "permissions": ["android.permission.CAMERA"],
      "package": "com.waterquality.hardnesstester"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Water Hardness Tester to access your camera to capture water samples."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec2624a0-6e43-41c0-b276-5bee573d3e32"
      }
    },
    "owner": "inphoton"
  }
}
